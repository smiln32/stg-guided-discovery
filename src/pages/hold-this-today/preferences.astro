---
// /hold-this-today/preferences/ — let subscribers change topic & frequency.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { paths } from '../../lib/urls';
import { EMAIL_TOPICS, FREQUENCIES } from '../../config/email.mjs';

const crumbs = [
  { label: 'Home', href: paths.home },
  { label: 'Manage email', href: paths.preferences },
];
---

<BaseLayout
  title="Update your email preferences"
  description="Change the kind of encouragement you receive, or how often, at any time."
  path={paths.preferences}
  noindex={true}
>
  <div class="container section">
    <Breadcrumbs crumbs={crumbs} />
    <header class="stack" style="margin-top: var(--space-md);">
      <h1>Update your preferences</h1>
      <p>Change what you receive, or how often. Whatever fits your season.</p>
    </header>

    <form class="card enhance-form" method="post" action="/.netlify/functions/preferences" novalidate style="margin-top: var(--space-lg);">
      <div class="field">
        <label for="email">Your email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="topic">Kind of encouragement</label>
        <select id="topic" name="topic">
          <option value="">No change</option>
          {EMAIL_TOPICS.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </div>
      <fieldset class="field">
        <legend>How often</legend>
        {FREQUENCIES.map((f, i) => (
          <label class="radio" style="display:flex;gap:.6em;align-items:center;">
            <input type="radio" name="frequency" value={f.value} checked={i === 1} style="width:auto;min-height:auto;" />
            {f.label}
          </label>
        ))}
      </fieldset>
      <button class="btn btn--primary" type="submit">Save preferences</button>
      <p class="form-status" role="status" aria-live="polite" hidden></p>
    </form>

    <p style="margin-top: var(--space-md); color: var(--text-muted);">
      Would you rather stop altogether? You can <a href={paths.unsubscribe}>unsubscribe here</a>.
    </p>
  </div>

  <script>
    import { enhanceForm } from '../../lib/formEnhance';
    enhanceForm('.enhance-form', 'Your preferences have been updated. Thank you.');
  </script>
</BaseLayout>

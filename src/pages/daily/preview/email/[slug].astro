---
// /daily/preview/email/[slug]/ — preview the daily/ongoing email that
// an entry produces. Owner-facing, noindex, excluded from the sitemap.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getVisibleEntries } from '../../../../lib/entries';
import { renderEntryEmail } from '../../../../lib/email/render.mjs';
import { paths } from '../../../../lib/urls';

export async function getStaticPaths() {
  const entries = await getVisibleEntries();
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const email = renderEntryEmail(entry.data, { greetingName: 'friend' });
---

<BaseLayout
  title={`Email preview — ${entry.data.short_title}`}
  description="Preview the email this entry produces."
  path={paths.entry(entry.data.slug)}
  noindex={true}
>
  <div class="container container-wide section">
    <p class="eyebrow">Email preview</p>
    <h1>{entry.data.short_title}</h1>
    <dl class="meta">
      <div><dt>Subject</dt><dd>{email.subject}</dd></div>
      <div><dt>Preview text</dt><dd>{email.preview}</dd></div>
    </dl>
    <p><a href={paths.entry(entry.data.slug)}>← Back to the entry</a></p>

    <h2>Rendered HTML</h2>
    <iframe class="email-frame" title={`Email preview for ${entry.data.short_title}`} srcdoc={email.html}></iframe>

    <details>
      <summary>Plain-text version</summary>
      <pre class="plain">{email.text}</pre>
    </details>
  </div>
</BaseLayout>

<style>
  .meta { display: grid; gap: var(--space-sm); }
  .meta dt { font-size: var(--step--1); text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); font-weight: 600; }
  .meta dd { margin: 0; }
  .email-frame { width: 100%; max-width: 620px; height: 720px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: #fff; }
  .plain { white-space: pre-wrap; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: var(--space-sm); font-size: var(--step--1); overflow-x: auto; }
</style>

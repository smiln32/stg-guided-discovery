---
// /daily/help/[need]/[tier]/[slug]/ — REDIRECT to /daily/help/[need]/
//
// The old alternates under tier routes are now part of the full-page
// experience. Redirect so old links don't break.
import { needs } from '../../../../../lib/guided';
import { paths } from '../../../../../lib/urls';

export async function getStaticPaths() {
  return needs.map((need) => ({
    params: { need: need.slug, tier: 'any', slug: 'any' },
    props: { needSlug: need.slug },
  }));
}

const { needSlug } = Astro.props as { needSlug: string };
const target = paths.helpNeed(needSlug);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <title>Redirecting…</title>
  <link rel="canonical" href={target} />
</head>
<body>
  <p>This page has moved. <a href={target}>Continue to the guided experience.</a></p>
</body>
</html>

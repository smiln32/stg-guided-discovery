---
// /daily/help/[need]/ — the full-page guided experience.
//
// The visitor picks a need, lands here, and scrolls through one continuous
// page at her own pace: acknowledgment → Scripture → reflection → prayer →
// small step → deeper context → longer prayer → related encouragement →
// resources. No tier selection, no "how much time do you have," no
// step-by-step wizard. Depth is controlled by scrolling, not by choosing.
//
// This page opens the best match for the need. The other entries it could have
// opened are offered at the foot of the page and live at
// /daily/help/[need]/[slug]/ — see [slug].astro.
//
// Deep-linking: the main site can send a visitor directly with
//   /daily/help/?need=comfort
// which is equivalent to arriving at /daily/help/ and selecting "I need
// comfort." The help index page handles that redirect; this page is the
// destination.
//
// noindex: a journey recombines content whose canonical home is
// /daily/[slug]/. Search should find that page, not this one.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SafetyNote from '../../../../components/SafetyNote.astro';
import GuidedHeader from '../../../../components/GuidedHeader.astro';
import FullPageJourney from '../../../../components/FullPageJourney.astro';
import {
  needs, candidatesFor, buildJourney, FULL_PAGE_TIER,
  type Journey, type Need,
} from '../../../../lib/guided';
import { getVisibleEntries, buildNow } from '../../../../lib/entries';
import { paths } from '../../../../lib/urls';

export async function getStaticPaths() {
  const now = buildNow();
  const visible = await getVisibleEntries(now);
  const out = [];
  for (const need of needs) {
    const candidates = await candidatesFor(need, FULL_PAGE_TIER, now, visible);
    if (candidates.length === 0) continue;
    out.push({
      params: { need: need.slug },
      props: {
        need,
        journey: await buildJourney(
          need, FULL_PAGE_TIER, candidates[0], candidates, now, visible,
        ),
      },
    });
  }
  return out;
}

const { need, journey } = Astro.props as { need: Need; journey: Journey };

const crumbs = [
  { label: 'Home', href: paths.home },
  { label: 'Find help today', href: paths.help },
  { label: need.short, href: paths.helpNeed(need.slug) },
];
---

<BaseLayout
  title={`${need.short} — Scripture, a prayer, and one small step`}
  description={`${need.question} A Scripture-centered encouragement page you can scroll through at your own pace.`}
  path={paths.helpNeed(need.slug)}
  noindex={true}
>
  <div class="container container-wide section">
    <Breadcrumbs crumbs={crumbs} />

    <GuidedHeader need={need} />

    <div class="journey-full__body">
      <FullPageJourney journey={journey} />
    </div>

    <SafetyNote />
  </div>
</BaseLayout>

<style>
  .journey-full__body {
    margin-top: var(--space-md);
  }
</style>

---
// /daily/help/ — "What are you carrying today?"
//
// The visitor-facing front door of guided discovery. One gentle question,
// nine plain answers, and a way out to browsing if none of them fit.
// Nothing is measured here and nothing is stored; choosing an answer is
// only choosing a link.
//
// Deep-linking: the main site can send a visitor directly with
//   /daily/help/?need=comfort
// which redirects to /daily/help/comfort/. This page handles that
// client-side so a static build can support it without a server.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SafetyNote from '../../../components/SafetyNote.astro';
import { needs } from '../../../lib/guided';
import { paths } from '../../../lib/urls';
import { breadcrumbJsonLd } from '../../../lib/jsonld';

const crumbs = [
  { label: 'Home', href: paths.home },
  { label: 'Find help today', href: paths.help },
];

// Build a lookup map for client-side deep-link redirect.
const needSlugs = needs.map((n) => n.slug);
---

<BaseLayout
  title="What are you carrying today?"
  description="Answer one gentle question and receive Scripture, a prayer, and one small step for whatever you are carrying today. Scroll at your own pace."
  path={paths.help}
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <div class="container section">
    <Breadcrumbs crumbs={crumbs} />

    <header class="stack" style="margin-top: var(--space-md);">
      <p class="eyebrow">A place to begin</p>
      <h1>What are you carrying today?</h1>
      <p>
        You do not have to know exactly what you need, and you do not have to
        explain yourself. Choose whichever is closest to today. You can change
        your mind at any point — and scroll as much or as little as you like.
      </p>
    </header>

    <ul class="needs" aria-label="What would help most today">
      {
        needs.map((need) => (
          <li>
            <a
              href={paths.helpNeed(need.slug)}
              data-track="guided_need_selected"
              data-track-label={need.slug}
            >
              {need.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="alt-route">
      Or <a href={paths.topics}>browse by what you are carrying</a>, or
      <a href={paths.search}>search for a word, verse, or feeling</a>.
    </p>

    <p class="promise">
      Nothing on these pages asks you to sign up, and nothing you type is sent
      anywhere. Every verse shown has been checked against its translation
      before it was published here. You scroll at your own pace — a minute
      or thirty, all in one place.
    </p>

    <SafetyNote />
  </div>
</BaseLayout>

<script is:inline define:{{ needSlugs }}>
  // Deep-link: /daily/help/?need=comfort → /daily/help/comfort/
  (function () {
    var params = new URLSearchParams(window.location.search);
    var need = params.get('need');
    if (need && needSlugs.indexOf(need) !== -1) {
      var base = document.querySelector('base');
      var dest = window.location.pathname.replace(/\/help\/?$/, '/help/' + need + '/');
      // Ensure trailing slash
      if (!dest.endsWith('/')) dest += '/';
      window.location.replace(dest);
    }
  })();
</script>

<style>
  .needs {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
    display: grid;
    gap: var(--space-xs);
  }
  .needs a {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: var(--space-xs) var(--space-md);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--text);
    text-decoration: none;
  }
  .needs a:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .alt-route {
    margin-top: var(--space-lg);
    color: var(--text-soft);
  }
  .promise {
    margin-top: var(--space-md);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>

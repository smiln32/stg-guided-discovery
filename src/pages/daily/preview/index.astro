---
// /daily/preview/ — owner index of the Pin previews for every visible entry.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getVisibleEntries } from '../../../lib/entries';
import { paths } from '../../../lib/urls';
import { BASE_PATH } from '../../../config/site.mjs';

const entries = await getVisibleEntries();
---

<BaseLayout
  title="Pin previews"
  description="Preview the Pins each entry produces."
  path={`${BASE_PATH}/preview/`}
  noindex={true}
>
  <div class="container section">
    <p class="eyebrow">Owner preview</p>
    <h1>Preview outputs</h1>
    <p>Every approved entry produces a website page and a set of Pins. Preview them here before publishing.</p>

    <h2>Pins by entry</h2>
    <ul>
      {entries.map((e) => (
        <li>
          <a href={paths.pins(e.data.slug)}>{e.data.short_title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

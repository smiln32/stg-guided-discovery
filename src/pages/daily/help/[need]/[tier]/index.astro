---
// /daily/help/[need]/[tier]/ — REDIRECT to /daily/help/[need]/
//
// The old 1/5/15-minute tier structure has been replaced by a single
// full-page scroll experience. These routes redirect so old links don't
// break. The permanent entry URLs at /daily/[slug]/ are unchanged.
import { needs } from '../../../../../lib/guided';
import { paths } from '../../../../../lib/urls';

export async function getStaticPaths() {
  return needs.map((need) => ({
    params: { need: need.slug, tier: 'any' },
    props: { needSlug: need.slug },
  }));
}

const { needSlug } = Astro.props as { needSlug: string };
const target = paths.helpNeed(needSlug);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <title>Redirecting…</title>
  <link rel="canonical" href={target} />
</head>
<body>
  <p>This page has moved. <a href={target}>Continue to the guided experience.</a></p>
</body>
</html>

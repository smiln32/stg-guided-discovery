---
// Renders the Scripture exactly as supplied, always with reference + translation.
// If the text still holds the verification placeholder, we show a calm note and
// never present it as verified.
//
// Two rendering fixes (documented in docs/HANDOFF.md):
//   1. LORD small-caps: NASB sets the divine name in small capitals. The YAML
//      keeps plain "LORD" (searchable, copy-pasteable, survives the CSV round
//      trip) and the component wraps \bLORD\b in a span styled
//      text-transform: lowercase; font-variant: small-caps.
//   2. Poetic line breaks: scripture_text stored with line breaks (|- or >-
//      block scalar) renders with white-space: pre-line so Psalm poetry keeps
//      its line-initial capitals without touching a word of Scripture.
import { SCRIPTURE_PLACEHOLDER } from '../config/entry-fields.mjs';

const {
  text,
  reference,
  translation,
  verified = true,
} = Astro.props as {
  text: string;
  reference: string;
  translation: string;
  verified?: boolean;
};

const isPlaceholder = text.trim() === SCRIPTURE_PLACEHOLDER;

// Wrap \bLORD\b in a small-caps span. The underlying text stays "LORD" —
// searchable, copy-pasteable, and correct for screen readers.
const renderLORD = (s: string) =>
  s.replace(/\bLORD\b/g, '<span class="smallcaps">LORD</span>');
---

<figure class="scripture">
  <blockquote class="scripture__text" set:html={isPlaceholder ? '<em>Scripture text pending verification.</em>' : renderLORD(text)} />
  <figcaption>
    <cite class="scripture__ref">{reference} · {translation}</cite>
    {
      (!verified || isPlaceholder) && (
        <span class="verify-note"> (awaiting Scripture verification)</span>
      )
    }
  </figcaption>
</figure>

<style>
  .scripture__text {
    white-space: pre-line;
  }
  .smallcaps {
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 0.03em;
  }
</style>

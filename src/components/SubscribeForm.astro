---
// "A Gentle Note" signup. Works without JavaScript (posts to the Netlify
// function, which returns a calm confirmation page). With JS it submits in the
// background and shows an inline message. Collects only what it needs.
import { BRAND } from '../config/site.mjs';
import { EMAIL_TOPICS } from '../config/email.mjs';

const {
  defaultTopic = '',
  heading = BRAND.emailProgramName,
  source = 'website',
  compact = false,
} = Astro.props as {
  defaultTopic?: string;
  heading?: string;
  source?: string;
  compact?: boolean;
};
---

<section class="subscribe card" aria-labelledby="subscribe-heading">
  <p class="eyebrow">{BRAND.emailProgramName}</p>
  <h2 id="subscribe-heading">{heading}</h2>
  <p>{BRAND.emailProgramDescription}</p>

  <form
    class="subscribe__form"
    method="post"
    action="/.netlify/functions/subscribe"
    novalidate
  >
    <input type="hidden" name="source" value={source} />
    <!-- Honeypot: real people leave this empty. -->
    <p class="visually-hidden" aria-hidden="true">
      <label>Leave this field blank
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="field">
      <label for="sub-email">Email address <span aria-hidden="true">*</span></label>
      <input
        id="sub-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
        aria-required="true"
      />
    </div>

    {
      !compact && (
        <div class="field">
          <label for="sub-name">First name <span class="hint-inline">(optional)</span></label>
          <input id="sub-name" name="first_name" type="text" autocomplete="given-name" />
        </div>
      )
    }

    <div class="field">
      <label for="sub-topic">What kind of encouragement would be most helpful right now?</label>
      <p class="hint" id="sub-topic-hint">Optional — you can change this anytime.</p>
      <select id="sub-topic" name="topic" aria-describedby="sub-topic-hint">
        <option value="">Choose one (optional)</option>
        {
          EMAIL_TOPICS.map((t) => (
            <option value={t.value} selected={t.value === defaultTopic}>
              {t.label}
            </option>
          ))
        }
      </select>
    </div>

    {
      !compact && (
        <fieldset class="field">
          <legend>How often would you like to hear from us?</legend>
          <label class="radio"><input type="radio" name="frequency" value="daily" /> A gentle note most days</label>
          <label class="radio"><input type="radio" name="frequency" value="weekly" checked /> A weekly digest</label>
          <label class="radio"><input type="radio" name="frequency" value="occasional" /> Only now and then</label>
        </fieldset>
      )
    }

    <div class="field">
      <label class="consent">
        <input type="checkbox" name="consent" value="yes" required aria-required="true" />
        <span>Yes, I would like to receive {BRAND.emailProgramName} by email. I can
          unsubscribe at any time.</span>
      </label>
    </div>

    <button class="btn btn--primary" type="submit">Send me a gentle note</button>
    <p class="subscribe__privacy hint">
      We use your email only to send the encouragement you asked for. We never
      sell it, and every email includes a one-click unsubscribe.
    </p>

    <p class="form-status" role="status" aria-live="polite" hidden></p>
  </form>
</section>

<style>
  .subscribe .radio,
  .subscribe .consent {
    display: flex;
    gap: 0.6em;
    align-items: flex-start;
    margin-bottom: var(--space-2xs);
    font-weight: 400;
  }
  .subscribe input[type='radio'],
  .subscribe input[type='checkbox'] {
    width: auto;
    min-height: auto;
    margin-top: 0.35em;
  }
  .hint-inline {
    font-weight: 400;
    color: var(--text-muted);
  }
  .subscribe__privacy {
    margin-top: var(--space-xs);
  }
</style>

<script>
  // Progressive enhancement: submit in the background, show calm inline status.
  document.querySelectorAll<HTMLFormElement>('.subscribe__form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    form.addEventListener('submit', async (e) => {
      const email = form.querySelector<HTMLInputElement>('[name="email"]');
      const consent = form.querySelector<HTMLInputElement>('[name="consent"]');
      if (!status) return;

      // Let native validation handle empties/format first.
      if (!email?.value || !/.+@.+\..+/.test(email.value)) return;
      if (!consent?.checked) return;

      e.preventDefault();
      status.hidden = false;
      status.className = 'form-status';
      status.textContent = 'One moment…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams(new FormData(form) as any).toString(),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          status.className = 'form-status form-status--ok';
          status.textContent =
            data.message ||
            'Thank you. Please check your inbox to confirm and receive your first note.';
          form.reset();
          window.dispatchEvent(new CustomEvent('htt:signup', { detail: { source: form.source?.value } }));
        } else if (res.status === 409) {
          status.className = 'form-status form-status--ok';
          status.textContent =
            'You are already subscribed — no need to sign up again. You can update your preferences anytime.';
        } else {
          status.className = 'form-status form-status--error';
          status.textContent =
            data.message ||
            'We could not complete your subscription just now. Your information was not lost. Please try again in a moment.';
        }
      } catch {
        status.className = 'form-status form-status--error';
        status.textContent =
          'We could not reach the server just now. Your information was not lost. Please try again in a moment.';
      }
    });
  });
</script>

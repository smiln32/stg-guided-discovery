---
// /daily/pins/[slug]/ — owner-facing Pin preview + metadata + export.
// Shows every generated Pin at full fidelity with its copy, alt text, board,
// destination URL, UTM, filename, and an overflow check. noindex — this is a
// working/preview surface, not a public page.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getVisibleEntries, buildNow } from '../../../lib/entries';
import { buildPins, renderPinSvg } from '../../../lib/pins.mjs';
import { paths } from '../../../lib/urls';

export async function getStaticPaths() {
  const entries = await getVisibleEntries();
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const pins = buildPins(d).map((pin) => ({ pin, ...renderPinSvg(pin) }));
const crumbs = [
  { label: 'Home', href: paths.home },
  { label: d.short_title, href: paths.entry(d.slug) },
  { label: 'Pins', href: paths.pins(d.slug) },
];
function svgDataUri(svg: string) {
  return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
}
---

<BaseLayout
  title={`Pins — ${d.short_title}`}
  description={`Pinterest-ready Pin previews and metadata for ${d.short_title}.`}
  path={paths.pins(d.slug)}
  noindex={true}
>
  <div class="container container-wide section">
    <Breadcrumbs crumbs={crumbs} />
    <header class="stack" style="margin-top: var(--space-md);">
      <p class="eyebrow">Pin preview &amp; export</p>
      <h1>{d.short_title}</h1>
      <p>
        {pins.length} Pins generated from this entry. Previews use brand fonts in
        your browser. To export PNG files, run <code>npm run pins:export</code>
        (writes 1000×1500 PNGs to <code>/pin-exports</code>). Each Pin points to
        the permanent entry page.
      </p>
    </header>

    <div class="pins">
      {
        pins.map(({ pin, svg, overflow, lineCount }) => (
          <section class="pin-row card">
            <div class="pin-row__preview" set:html={svg} />
            <dl class="pin-row__meta">
              <div><dt>Type</dt><dd>{pin.type}</dd></div>
              <div><dt>Pin title</dt><dd>{pin.pin_title}</dd></div>
              <div><dt>Description</dt><dd>{pin.pin_description}</dd></div>
              <div><dt>Alt text</dt><dd>{pin.alt_text}</dd></div>
              <div><dt>Suggested board</dt><dd>{pin.board}</dd></div>
              <div><dt>Destination</dt><dd><a href={pin.destination}>{pin.destination}</a></dd></div>
              <div><dt>Filename</dt><dd><code>{pin.filename}</code></dd></div>
              <div>
                <dt>Overflow check</dt>
                <dd>
                  {overflow ? (
                    <span class="warn">⚠ {lineCount} lines — may be tight. Shorten the copy or preview carefully.</span>
                  ) : (
                    <span class="ok">✓ Fits the safe area ({lineCount} lines).</span>
                  )}
                </dd>
              </div>
              <div class="pin-row__actions">
                <a class="btn btn--soft" href={svgDataUri(svg)} download={pin.filename.replace(/\.png$/, '.svg')}>Download SVG</a>
              </div>
            </dl>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .pins { display: grid; gap: var(--space-lg); margin-top: var(--space-lg); }
  .pin-row { display: grid; gap: var(--space-md); }
  @media (min-width: 52rem) {
    .pin-row { grid-template-columns: 320px 1fr; align-items: start; }
  }
  .pin-row__preview :global(svg) {
    width: 100%; height: auto; border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }
  .pin-row__meta { margin: 0; display: grid; gap: var(--space-sm); }
  .pin-row__meta dt {
    font-size: var(--step--1); text-transform: uppercase; letter-spacing: .08em;
    color: var(--text-muted); font-weight: 600;
  }
  .pin-row__meta dd { margin: 0; word-break: break-word; }
  .warn { color: #7a5a1e; font-weight: 600; }
  .ok { color: #33613a; }
</style>

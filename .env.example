# -----------------------------------------------------------------------------
# Hold This Today — environment variables
#
# Copy to `.env` for local dev, and set the same keys in the Netlify UI
# (Site settings → Environment variables) for production. NEVER commit real
# secrets. Client code never sees these — they are used only at build time and
# inside Netlify Functions (server side).
# -----------------------------------------------------------------------------

# Public base URL. Canonical tags, sitemap, Pin destinations, and email links
# all derive from this. Set to your real domain before the first deploy.
SITE_URL=https://simplifytoglorify.com

# Which email backend to use:
#   mock            -> default; logs only, sends nothing (safe for dev/preview)
#   zoho_campaigns  -> Zoho Campaigns list subscribe + automation
#   zeptomail       -> Zoho ZeptoMail transactional send (self-managed list)
EMAIL_PROVIDER=mock

# ---- Zoho region (com, eu, in, com.au, jp) ----
ZOHO_REGION=com

# ---- Zoho Campaigns (EMAIL_PROVIDER=zoho_campaigns) ----
# Create an OAuth self-client in the Zoho API console and generate a token with
# the ZohoCampaigns scopes. Refresh the access token out of band as needed.
ZOHO_CAMPAIGNS_ACCESS_TOKEN=
ZOHO_CAMPAIGNS_LIST_KEY=

# ---- ZeptoMail (EMAIL_PROVIDER=zeptomail) ----
ZEPTOMAIL_TOKEN=
EMAIL_FROM_ADDRESS=hello@simplifytoglorify.com
EMAIL_FROM_NAME=Simplify to Glorify

# ---- Optional ----
# Override "today" for the build (testing scheduling/rotation). ISO 8601.
# BUILD_NOW=2026-07-10T12:00:00-06:00
#
# Durable subscriber-store directory (dev only; production must use a real DB
# or Netlify Blobs — see docs). Defaults to .data locally, /tmp on Netlify.
# HTT_DATA_DIR=.data

---
// Calm 404 — also the landing spot for a draft/unpublished URL, which is never
// built. No alarming language.
import BaseLayout from '../layouts/BaseLayout.astro';
import { paths } from '../lib/urls';
---

<BaseLayout
  title="This page isn't here"
  description="The page you were looking for isn't here, but there is still something to hold today."
  path="/404/"
  noindex={true}
>
  <div class="container section stack">
    <p class="eyebrow">Not found</p>
    <h1>This page isn't here right now</h1>
    <p>
      The link may have changed, or the encouragement may still be in
      preparation. Nothing is lost — here are a few gentle ways forward.
    </p>
    <div class="continue-nav" style="display:flex;flex-wrap:wrap;gap:var(--space-xs);">
      <a class="btn btn--primary" href={paths.home}>Today's encouragement</a>
      <a class="btn btn--soft" href={paths.topics}>Browse by need</a>
      <a class="btn btn--soft" href={paths.search}>Search</a>
    </div>
  </div>
</BaseLayout>
